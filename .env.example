# Telegram Bot Configuration
# Obtain your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram chat ID — use @userinfobot to find yours
TELEGRAM_CHAT_ID=your_chat_id_here

# OpenClaw Gateway Configuration
# Port for the prayerbot OpenClaw profile (default: 18790)
OPENCLAW_PORT=18790

# Optional: OpenClaw gateway auth token for local API calls (theologian reflection)
OPENCLAW_GATEWAY_TOKEN=

# Private daily prayer schedule file (keep this on the Pi; do not commit)
PRAYER_DAILY_FILE=/home/pi/prayerbot/.private/daily_prayers.json

# Telegram command polling state (keep this on the Pi; do not commit)
PRAYER_COMMAND_STATE_FILE=/home/pi/prayerbot/.private/command_state.json

# Optional dedicated bot token for prayer command polling.
# If empty, prayerlist.py uses TELEGRAM_BOT_TOKEN.
PRAYER_COMMAND_BOT_TOKEN=
